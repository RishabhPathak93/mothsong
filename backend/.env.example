# ─────────────────────────────────────────────────────────────────────────────
# Mothsong backend environment
# Copy to `.env` for local dev. On Render, set these in the dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# Main public API port. Render injects PORT automatically — do NOT hardcode it there.
PORT=4000

# Internal "private microservice" port. Bound to 127.0.0.1 only, never exposed
# externally. This is the SSRF target (flag #2). 8000 is a common internal/dev port
# that appears in standard SSRF payload lists; the service serves the flag at its root.
INTERNAL_PORT=8000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/mothsong
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/mothsong?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/mothsong

# Secret used to sign auth JWTs. Generate a long random value per engagement.
JWT_SECRET=change-me-to-a-long-random-string

# The exact origin of the deployed frontend (Vercel). Used for CORS + cookies.
# MUST match the frontend's real URL exactly, scheme included, no trailing slash.
# Example: https://mothsong.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Set to "production" on Render so cookies are Secure + SameSite=None (cross-site).
NODE_ENV=development

# RCE flag (#4). Normally the seed script writes this into data/flags.json and the
# server loads it into process.env at boot. You can also set it here directly if you
# want the RCE target to read it straight from the environment.
# FLAG_RCE=MOTHSONG{...}
